{
  "name": "icf-devcontainer",
  "services": {
    "dev": {
      "image": "mcr.microsoft.com/devcontainers/dotnet:2-10.0",
      "init": true,
      "command": "sleep infinity",
      "working_dir": "/workspaces/icf",
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ConnectionStrings__ICFAccounting": "Host=postgres;Port=5432;Database=icfaccounting;Username=postgres;Password=${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in the root .env file}",
        "ASPNETCORE_Kestrel__Certificates__Default__Path": "/home/vscode/.aspnet/https/icfaccounting-web.pem",
        "ASPNETCORE_Kestrel__Certificates__Default__KeyPath": "/home/vscode/.aspnet/https/icfaccounting-web.key",
        "DirectoryBuildPropsPath": "/workspaces/icf/.devcontainer/dotnet.props",
        "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal",
        "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE": "/var/run/docker.sock"
      },
      "volumes": [
        ".:/workspaces/icf:cached",
        "dotnet-build:/home/vscode/.cache/icf",
        "nuget-packages:/home/vscode/.nuget/packages",
        {
          "type": "volume",
          "source": "web-node-modules",
          "target": "/workspaces/icf/src/ICFAccounting.Web/node_modules",
          "volume": {
            "nocopy": true
          }
        }
      ]
    },
    "postgres": {
      "image": "postgres:17",
      "environment": {
        "POSTGRES_DB": "icfaccounting",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD to a strong local development password}"
      },
      "ports": [
        "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
      ],
      "volumes": [
        "postgres-data:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""
        ],
        "interval": "10s",
        "timeout": "10s",
        "retries": 12,
        "start_period": "30s"
      }
    }
  },
  "volumes": {
    "dotnet-build": {},
    "nuget-packages": {},
    "web-node-modules": {},
    "postgres-data": {}
  }
}